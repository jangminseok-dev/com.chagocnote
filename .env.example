# 값은 비워 둔다. 개발용 실제 값은 backend/scripts/generate_dev_env.py 가 .env 와 .env.auth 로 만든다.
APP_ENV=dev
DATABASE_URL=
REDIS_URL=
JWT_PUBLIC_KEY_B64=
# 아래 셋은 .env.auth 에만 둔다 (인증 프로세스 전용)
JWT_PRIVATE_KEY_B64=
IDENTITY_TOKEN_ENC_KEY=
KAKAO_ADMIN_KEY=
# 소셜 로그인 — 제공자 콘솔에 앱을 등록한 뒤 채운다. 비어 있으면 그 제공자는 꺼진다.
KAKAO_APP_ID=
KAKAO_REST_API_KEY=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
APPLE_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_B64=
# MinIO (계획 1에서는 기동만 한다)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
# 미용 알림장 — 링크 서명 키(32바이트 이상을 base64 로. 없으면 API·인증 프로세스가 기동하지 않는다),
# 보호자 웹의 주소(기본 http://127.0.0.1:3010), 웹 서버와 나누는 비밀값(비우면 웹 서버가 알려 준 접속 주소를 믿지 않는다)
REPORT_LINK_KEY_B64=
REPORT_WEB_BASE_URL=
REPORT_WEB_SECRET=
