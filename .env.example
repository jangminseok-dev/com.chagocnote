# 값은 비워 둔다. 개발용 실제 값은 backend/scripts/generate_dev_env.py 가 .env 와 .env.auth 로 만든다.
APP_ENV=dev
DATABASE_URL=
REDIS_URL=
JWT_PUBLIC_KEY_B64=
# 아래 셋은 .env.auth 에만 둔다 (인증 프로세스 전용)
JWT_PRIVATE_KEY_B64=
IDENTITY_TOKEN_ENC_KEY=
KAKAO_ADMIN_KEY=
# 소셜 로그인 — 제공자 콘솔에 앱을 등록한 뒤 채운다. 비어 있으면 그 제공자는 꺼진다.
KAKAO_APP_ID=
KAKAO_REST_API_KEY=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
APPLE_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_B64=
# MinIO (계획 1에서는 기동만 한다)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
# 미용 알림장 — 링크 서명 키(32바이트 이상을 base64 로. 없으면 API·인증 프로세스가 기동하지 않는다),
# 보호자 웹의 주소(기본 http://127.0.0.1:3010), 웹 서버와 나누는 비밀값(비우면 웹 서버가 알려 준 접속 주소를 믿지 않는다)
# 보호자 웹(compose 의 web)도 이 파일에서 REPORT_WEB_SECRET 을 읽는다 — 웹에서는 필수다(없으면 web 이 오류를 찍고 끝난다).
# 웹이 읽는 다른 값 API_BASE_URL(백엔드 주소)은 compose 가 넣는다(http://backend:8000). 여기에 두지 않는다.
REPORT_LINK_KEY_B64=
REPORT_WEB_BASE_URL=
REPORT_WEB_SECRET=
# 보호자 웹의 로그인 — 세션 쿠키를 봉하는 비밀값(32글자 이상, 예: openssl rand -base64 48). 웹에서 필수다.
# 인증 주소 AUTH_BASE_URL 과 개발용 로그인 DEV_LOGIN 은 compose 가 넣는다.
WEB_SESSION_SECRET=
# 알림톡 — 솔라피 API 키(둘 다 비우면 dev 는 가짜 어댑터, 운영은 API 프로세스가 기동하지 않는다),
# 잔액 경고 기준(원, 기본 30000), 매장별 하루 발송 상한(기본 300)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_BALANCE_WARN_KRW=
NOTIFICATION_DAILY_CAP=
